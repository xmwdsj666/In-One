  font-size: $fs-md;
  font-weight: bold;
  color: $ink;
}
.sug-def {
  flex: 1;
  font-size: $fs-xs;
  color: $sub;
  margin-left: 14px;
  lines: 1;
  text-overflow: ellipsis;
  text-align: right;
}

/* 键盘 */
.keyboard {
  @include flex(column, center, center);
  width: 406px;
  margin-top: 10px;
}
