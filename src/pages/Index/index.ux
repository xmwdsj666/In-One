<script>
  import dict from '../../common/dict.js'

  // QWERTY 三行（每行键数不同，按行渲染）
  const ROW1 = 'qwertyuiop'.split('')
  const ROW2 = 'asdfghjkl'.split('')
  const ROW3 = 'zxcvbnm'.split('')

  export default {
    data: {
      view: 'search', // search 搜索 | detail 详情（单页双视图，返回保留搜索状态）
      query: '',
      hasQuery: false,
      showPh: true,
      rows: [], // 联想结果 [{w,l,d}]
      resultCount: 0,
      hasResult: false,
      showEgg: false, // 彩蛋：输入 qwq 触发
      showKb: true, // 26 键键盘折叠态
      showZoneKb: false, // 联想区（键盘展开态）预计算字段，规避模板 && 表达式
      showZoneFull: false, // 联想区（键盘收起态）
      row1: ROW1,
      row2: ROW2,
      row3: ROW3,
      // 详情视图字段（openDetail 预处理，模板只做字段直绑）
      dHead: '',
      dPhone: '',
      dTags: '',
      dDefs: '',
      dPhrases: '',
      dHasPhrase: false,
      dSentEn: '',
      dSentCn: '',
      dHasSent: false,
    },

    // 点字母键：插入并联想（$idx 为行内下标）
    insertRow1(idx) {
      this.applyQuery(this.query + this.row1[idx])
    },
    insertRow2(idx) {
      this.applyQuery(this.query + this.row2[idx])
    },
    insertRow3(idx) {
      this.applyQuery(this.query + this.row3[idx])
    },

    // 键盘折叠切换
    onToggleKb() {
      this.showKb = !this.showKb
      this.syncZones()
    },

    // 退格 / 清空
    onBackspace() {
      if (!this.query) return
      this.applyQuery(this.query.slice(0, -1))
    },
    onClear() {
      this.applyQuery('')
    },

    syncZones() {
      this.showZoneKb = this.hasResult && this.showKb
      this.showZoneFull = this.hasResult && !this.showKb
    },

    applyQuery(q) {
      this.query = q
      this.hasQuery = !!q
      this.showPh = !q
      this.showEgg = q === 'qwq'
      if (!/^[a-z]/.test(q)) {
        this.rows = []
        this.resultCount = 0
        this.hasResult = false
        return
      }
      const sug = dict.suggest(q, 30)
      this.rows = sug.map(x => {
        const rec = dict.find(x.w)
        return { w: x.w, d: rec && rec.t && rec.t.length ? rec.t[0] : '' }
      })
      this.resultCount = this.rows.length
      this.hasResult = true
      this.syncZones()
    },

    // 联想行点击（$idx 下标取行）→ 打开详情视图
    onRowTap(idx) {
      const r = this.rows[idx]
      if (!r) return
      this.openDetail(r.w)
    },

    openDetail(word) {
      const rec = dict.find(word)
      if (!rec) {
        this.dHead = word
        this.dPhone = ''
        this.dTags = ''
        this.dDefs = ''
        this.dPhrases = ''
        this.dHasPhrase = false
        this.dSentEn = ''
        this.dSentCn = ''
        this.dHasSent = false
      } else {
        this.dHead = rec.a || rec.w
        this.dPhone = rec.p ? '/' + rec.p + '/' : ''
        this.dTags = (rec.l || '').split('').map(t => dict.tagName(t)).join(' · ')
        this.dDefs = (rec.t || []).join('\n')
        this.dPhrases = (rec.ph || []).map(x => {
          const i = x.indexOf('|')
          return x.slice(0, i) + '\n' + x.slice(i + 1)
        }).join('\n')
        this.dHasPhrase = !!this.dPhrases
        const s = rec.s || ''
        const si = s.indexOf('|')
        this.dSentEn = si === -1 ? s : s.slice(0, si)
        this.dSentCn = si === -1 ? '' : s.slice(si + 1)
        this.dHasSent = !!this.dSentEn
      }
      this.view = 'detail'
    },

    // 详情返回搜索态（保留 query 与联想结果）
    goBack() {
      this.view = 'search'
    },
  }
</script>

<template>
  <div class="page">
    <!-- 搜索视图 -->
    <div class="search-view" if="{{ view === 'search' }}">
      <!-- 胶囊搜索框 -->
      <div class="search-box">
        <image class="search-ico" src="../../assets/images/search.png" />
        <text class="search-text" if="{{ hasQuery }}">{{ query }}</text>
        <text class="search-ph" if="{{ showPh }}">请输入单词</text>
        <div class="clear-btn" if="{{ hasQuery }}" onclick="onClear">
          <text class="clear-t">×</text>
        </div>
      </div>

      <!-- 联想区：键盘展开态（列表让位给键盘） -->
      <list class="zone zone-kb" if="{{ showZoneKb }}">
        <list-item type="egg">
          <div class="egg-card" if="{{ showEgg }}">
            <text class="egg-main">In One 词典的作者 qwq 喵</text>
            <text class="egg-sub">被你发现了，喵~ 谢谢使用 In One</text>
          </div>
        </list-item>
        <list-item type="cnt">
          <div class="cnt-wrap" if="{{ hasResult }}">
            <text class="result-count">找到 {{ resultCount }} 个结果</text>
          </div>
        </list-item>
        <list-item type="sug" for="{{ rows }}" onclick="onRowTap($idx)">
          <div class="sug-item">
            <text class="sug-word">{{ $item.w }}</text>
            <text class="sug-def">{{ $item.d }}</text>
          </div>
        </list-item>
      </list>

      <!-- 联想区：键盘收起态（占满屏） -->
      <list class="zone zone-full" if="{{ showZoneFull }}">
        <list-item type="egg">
          <div class="egg-card" if="{{ showEgg }}">
            <text class="egg-main">In One 词典的作者 qwq 喵</text>
            <text class="egg-sub">被你发现了，喵~ 谢谢使用 In One</text>
          </div>
        </list-item>
        <list-item type="cnt">
          <div class="cnt-wrap" if="{{ hasResult }}">
            <text class="result-count">找到 {{ resultCount }} 个结果</text>
          </div>
        </list-item>
        <list-item type="sug" for="{{ rows }}" onclick="onRowTap($idx)">
          <div class="sug-item">
            <text class="sug-word">{{ $item.w }}</text>
            <text class="sug-def">{{ $item.d }}</text>
          </div>
        </list-item>
      </list>

      <!-- 键盘折叠切换条：展开态（钉在键盘上方） -->
      <div class="kb-toggle toggle-kb" if="{{ showKb }}" onclick="onToggleKb">
        <text class="kb-toggle-t">收起键盘</text>
      </div>
      <!-- 键盘折叠切换条：收起态（钉在屏底） -->
      <div class="kb-toggle toggle-full" if="{{ showListZone }}" onclick="onToggleKb">
        <text class="kb-toggle-t">展开键盘</text>
      </div>

      <!-- 键盘折叠切换条 -->
      <div class="kb-toggle" onclick="onToggleKb">
        <text class="kb-toggle-t">{{ showKb ? '收起键盘' : '展开键盘' }}</text>
      </div>

      <!-- 26 键键盘 -->
      <div class="keyboard" if="{{ showKb }}">
        <div class="kb-row">
          <div class="kb-key" for="{{ row1 }}" onclick="insertRow1($idx)">
            <text class="kb-t">{{ $item }}</text>
          </div>
        </div>
        <div class="kb-row kb-row-mid">
          <div class="kb-key kb-key-mid" for="{{ row2 }}" onclick="insertRow2($idx)">
            <text class="kb-t">{{ $item }}</text>
          </div>
        </div>
        <div class="kb-row kb-row-last">
          <div class="kb-key kb-key-last" for="{{ row3 }}" onclick="insertRow3($idx)">
            <text class="kb-t">{{ $item }}</text>
          </div>
        </div>
        <div class="kb-row">
          <div class="fn-key" onclick="onBackspace"><text class="fn-t">退格</text></div>
          <div class="fn-key" onclick="onClear"><text class="fn-t">清空</text></div>
        </div>
      </div>
    </div>

    <!-- 详情视图：‹返回 + 金色词 + 音标 + 释义卡 -->
    <scroll class="detail-view" if="{{ view === 'detail' }}" scroll-y="true">
      <div class="back-btn" onclick="goBack">
        <text class="back-t">‹ 返回</text>
      </div>
      <text class="head">{{ dHead }}</text>
      <text class="phone">{{ dPhone }}</text>
      <text class="tags" if="{{ dTags }}">{{ dTags }}</text>
      <div class="card">
        <text class="defs">{{ dDefs }}</text>
      </div>
      <div class="card" if="{{ dHasPhrase }}">
        <text class="sec-title">短语</text>
        <text class="phrase">{{ dPhrases }}</text>
      </div>
      <div class="card" if="{{ dHasSent }}">
        <text class="sec-title">例句</text>
        <text class="sent-en">{{ dSentEn }}</text>
        <text class="sent-cn">{{ dSentCn }}</text>
      </div>
    </scroll>
  </div>
</template>

<style lang="scss">
@import './../../assets/styles/style.scss';

/* 布局：横向百分比（随屏缩放不裁切）+ 关键区域绝对定位钉底 */
.page {
  position: relative;
  width: 466px;
  height: 100%;
  background-color: $bg;
}

/* 胶囊搜索框：顶部流式 */
.search-box {
  @include flex(row, flex-start, center);
  position: absolute;
  top: 44px;
  left: 20px;
  right: 20px;
  height: 52px;
  background-color: $card;
  border-radius: 26px;
  padding: 0 6px 0 18px;
}
.search-ico {
  width: 26px;
  height: 26px;
  margin-right: 10px;
}
.search-text {
  flex: 1;
  font-size: $fs-md;
  color: $ink;
}
.search-ph {
  flex: 1;
  font-size: $fs-sm;
  color: $sub;
}
.clear-btn {
  @include flex(row, center, center);
  width: 42px;
  height: 42px;
  border-radius: 21px;
  background-color: $key;
}
.clear-t {
  font-size: $fs-md;
  color: $sub;
}

/* 联想区（绝对定位，键盘展开时让位、收起时占满） */
.zone {
  position: absolute;
  left: 20px;
  right: 20px;
}
.zone-kb {
  top: 106px;
  height: 128px;
}
.zone-full {
  top: 106px;
  height: 314px;
}
.cnt-wrap {
  padding: 4px 4px 8px 4px;
}
.sug-item {
  @include flex(row, space-between, center);
  width: 100%;
  height: 60px;
  background-color: $card;
  border-radius: $radius-s;
  margin-bottom: 8px;
  padding: 0 18px;
}
.sug-word {
  font-size: $fs-md;
  font-weight: bold;
  color: $ink;
}
.sug-def {
  flex: 1;
  font-size: $fs-xs;
  color: $sub;
  margin-left: 12px;
  lines: 1;
  text-overflow: ellipsis;
  text-align: right;
}
.egg-card {
  @include flex(column, flex-start, flex-start);
  width: 100%;
  background-color: $card;
  border-radius: $radius-s;
  margin-bottom: 8px;
  padding: 12px 18px;
}
.egg-main {
  font-size: $fs-sm;
  font-weight: bold;
  color: $gold;
}
.egg-sub {
  font-size: $fs-xs;
  color: $sub;
  margin-top: 4px;
}
.result-count {
  font-size: $fs-xs;
  color: $sub;
  padding: 4px 4px 8px 4px;
}

/* 键盘（百分比键宽 + space-between 均分，随屏缩放永不溢出） */
.keyboard {
  position: absolute;
  left: 20px;
  right: 20px;
  bottom: 10px;
}
.kb-row {
  @include flex(row, space-between, center);
  width: 100%;
  margin-bottom: 4px;
}
.kb-key {
  @include flex(row, center, center);
  width: 8.8%;
  height: 46px;
  background-color: $key;
  border-radius: $radius-s;
}
.kb-row-mid {
  width: 92%;
  margin-left: 4%;
}
.kb-key-mid {
  width: 9.6%;
}
.kb-row-last {
  width: 86%;
  margin-left: 7%;
}
.kb-key-last {
  width: 12%;
}
.kb-t {
  font-size: $fs-sm;
  color: $ink;
}
.fn-key {
  @include flex(row, center, center);
  width: 26%;
  height: 42px;
  background-color: $key;
  border-radius: $radius-s;
}
.fn-t {
  font-size: $fs-sm;
  color: $ink;
}

/* 键盘折叠切换条（钉在键盘上方） */
.kb-toggle {
  position: absolute;
  left: 20px;
  right: 20px;
  height: 30px;
  @include flex(row, center, center);
}
.toggle-kb {
  bottom: 198px;
}
.toggle-full {
  bottom: 10px;
}
.kb-toggle-t {
  font-size: $fs-xs;
  color: $sub;
}

/* 详情视图 */
.detail-view {
  position: absolute;
  top: 40px;
  left: 20px;
  right: 20px;
  bottom: 16px;
}
.back-btn {
  @include flex(row, flex-start, center);
  height: 48px;
}
.back-t {
  font-size: $fs-sm;
  color: $ink;
  font-weight: bold;
}
.head {
  font-size: $fs-xl;
  font-weight: bold;
  color: $gold;
  margin-top: 8px;
}
.phone {
  font-size: $fs-sm;
  color: $sub;
  margin-top: 6px;
}
.tags {
  font-size: $fs-xs;
  color: $sub;
  margin-top: 8px;
}
.card {
  @include flex(column, flex-start, flex-start);
  width: 100%;
  background-color: $card;
  border-radius: $radius;
  margin-top: 16px;
  padding: 18px 22px;
}
.sec-title {
  font-size: $fs-xs;
  color: $sub;
  margin-bottom: 8px;
}
.defs {
  font-size: $fs-md;
  color: $ink;
  lines: 8;
}
.phrase {
  font-size: $fs-sm;
  color: $ink;
  lines: 4;
}
.sent-en {
  font-size: $fs-sm;
  color: $ink;
}
.sent-cn {
  font-size: $fs-xs;
  color: $sub;
  margin-top: 8px;
}
</style>